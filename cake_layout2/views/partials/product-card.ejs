<div class="col-sm-3">
	<div class="single-item">
		<% if (product.isSale) { %>
		<div class="ribbon-wrapper"><div class="ribbon sale">Sale</div></div>
		<% } %>
		<div class="single-item-header">
			<a href="<%= product.detailUrl %>"><img src="<%= product.image %>" alt="<%= product.name %>"></a>
		</div>
		<div class="single-item-body">
			<p class="single-item-title"><%= product.name %></p>
			<p class="single-item-price">
				<% if (product.oldPrice) { %>
				<span class="flash-del"><%= product.oldPrice %></span>
				<% } %>
				<span class="<%= product.oldPrice ? 'flash-sale' : '' %>"><%= product.price %></span>
			</p>
		</div>
		<div class="single-item-caption">
			<a class="add-to-cart pull-left" href="shopping_cart.html"><i class="fa fa-shopping-cart"></i></a>
			<a class="beta-btn primary" href="<%= product.detailUrl %>">Details <i class="fa fa-chevron-right"></i></a>
			<div class="clearfix"></div>
		</div>
	</div>
</div>